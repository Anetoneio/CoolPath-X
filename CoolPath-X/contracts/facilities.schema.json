{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "facilities.geojson",
  "description": "Point features for water and shade facilities in Ahmedabad.",
  "type": "object",
  "required": ["type", "features"],
  "properties": {
    "type": { "const": "FeatureCollection" },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "properties", "geometry"],
        "properties": {
          "type": { "const": "Feature" },
          "geometry": {
            "type": "object",
            "required": ["type", "coordinates"],
            "properties": {
              "type": { "const": "Point" },
              "coordinates": {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 2,
                "maxItems": 2
              }
            }
          },
          "properties": {
            "type": "object",
            "required": ["id", "type", "verified", "source"],
            "properties": {
              "id": { "type": "string" },
              "type": { "enum": ["water", "shade"] },
              "verified": { "type": "boolean" },
              "source": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}